# Port the Mashghal dashboard is exposed on (host side)
DASHBOARD_PORT=4000

# Paths to the sibling app repos, relative to this directory.
# Used by scripts/start.sh and scripts/stop.sh to bring the whole
# workshop up/down alongside the dashboard. Adjust if your checkouts
# don't sit in the default layout described in the README.
CHOCOLATE_MOLD_FACTORY_PATH=../chocolate-mold-factory
PLATESMITH_PATH=../platesmith
THREED_PRINTING_WORKSHOP_PATH=../../3d-printing-workshop
